datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  WORKER
  BUSINESS_OWNER
  ADMIN
}

enum WageType {
  DAILY
  FIXED
}

enum JobType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  CONTRACT
}

enum JobStatus {
  OPEN
  FILLED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum TransactionType {
  CREDIT
  REPAYMENT
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  email             String?        @unique
  phone             String         @unique
  passwordHash      String
  role              Role           @default(WORKER)
  preferredLanguage String         @default("en")
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workerProfile     WorkerProfile?
  businesses        Business[]
  notifications     Notification[]

  @@index([phone])
  @@index([role])
}

model WorkerProfile {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            String
  locality        String
  skills          String[]
  experienceYears Int              @default(0)
  description     String?
  availability    Boolean          @default(true)
  profileImage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  jobApplications JobApplication[]

  @@index([city])
  @@index([availability])
}

model Business {
  id          String     @id @default(uuid()) @db.Uuid
  ownerId     String     @db.Uuid
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  category    String
  phone       String
  city        String
  locality    String
  address     String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  jobs        Job[]
  products    Product[]
  customers   Customer[]
  sales       Sale[]

  @@index([ownerId])
  @@index([city])
  @@index([category])
}

model Job {
  id             String           @id @default(uuid()) @db.Uuid
  businessId     String           @db.Uuid
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title          String
  description    String
  requiredSkills String[]
  city           String
  locality       String
  wageAmount     Decimal          @db.Decimal(10, 2)
  wageType       WageType         @default(DAILY)
  jobType        JobType          @default(FULL_TIME)
  status         JobStatus        @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  applications   JobApplication[]

  @@index([businessId])
  @@index([city])
  @@index([status])
}

model JobApplication {
  id        String            @id @default(uuid()) @db.Uuid
  jobId     String            @db.Uuid
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId  String            @db.Uuid
  worker    WorkerProfile     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  message   String?
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([jobId, workerId])
  @@index([jobId])
  @@index([workerId])
  @@index([status])
}

model Product {
  id                 String     @id @default(uuid()) @db.Uuid
  businessId         String     @db.Uuid
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  category           String
  sku                String?
  sellingPrice       Decimal    @db.Decimal(10, 2)
  costPrice          Decimal?   @db.Decimal(10, 2)
  stockQuantity      Int        @default(0)
  lowStockThreshold  Int        @default(5)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  saleItems          SaleItem[]

  @@index([businessId])
  @@index([name])
}

model Customer {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  phone              String?
  address            String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  creditTransactions CreditTransaction[]
  sales              Sale[]

  @@index([businessId])
  @@index([phone])
}

model CreditTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  customerId  String          @db.Uuid
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  saleId      String?         @db.Uuid
  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?       @db.Uuid
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID)
  createdAt     DateTime      @default(now())

  items         SaleItem[]

  @@index([businessId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @db.Uuid
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)

  @@index([saleId])
  @@index([productId])
}

model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String
  type            String
  isRead          Boolean  @default(false)
  relatedEntityId String?  @db.Uuid
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
